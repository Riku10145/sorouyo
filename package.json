    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "@cloudflare/vite-plugin": "1.69.1",
    "wrangler": "4.162.0",
    "vitest": "5.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
